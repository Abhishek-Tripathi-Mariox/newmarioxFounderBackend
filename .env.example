# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5180

# ---- Database (MongoDB) ----
# App database; the URI must name the database. Use a replica set / Atlas outside local development
# (a standalone server has no multi-document transactions — see docs/MONGO.md).
MONGODB_URI=mongodb://127.0.0.1:27017/marioxone_dev
# Tests: server only — every jest run creates and drops its own marioxone_test_<random> database.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017
DB_POOL_MAX=10

# ---- Auth ----
# Use long random strings in production: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=10

# ---- File storage (uploads: lead / project / bug / change-request documents) ----
# s3    = AWS S3 or any S3-compatible store (production)
# local = files on disk under UPLOAD_DIR (only for quick runs; the test suite uses it automatically)
STORAGE_DRIVER=s3
S3_BUCKET=mariox-portal-documents
S3_REGION=ap-south-1
# AWS: leave S3_ENDPOINT / keys empty and give the server an IAM role (or env/profile credentials)
#      with s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket on the bucket.
# Local MinIO (`npm run storage:up`): endpoint + path-style + the MinIO user/password from docker-compose.yml
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=mariox
S3_SECRET_ACCESS_KEY=mariox_dev_password
# Create the bucket on startup if it doesn't exist (local MinIO convenience — keep false on AWS)
S3_CREATE_BUCKET=true
# Optional key prefix inside the bucket, e.g. portal/
S3_PREFIX=
# Encryption at rest: AES256 (S3-managed), aws:kms (+ S3_KMS_KEY_ID) or none (MinIO without KMS)
S3_SSE=none
# Downloads: proxy = stream through the API (default, no bucket CORS needed)
#            redirect = 302 to a short-lived presigned URL (needs bucket CORS for the web origin)
S3_DOWNLOAD_MODE=proxy
S3_PRESIGN_TTL_SECONDS=300
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---- Logging ----
LOG_LEVEL=info

# ---- Time ----
# IANA time zone for working days (check-in, late after 10:30, timesheet days)
APP_TZ=Asia/Kolkata

# First Super Admin, created by `npm run seed` (only if no Super Admin exists yet).
# Leave the password empty to generate a random one (printed once by the seed).
SUPER_ADMIN_NAME=CEO
SUPER_ADMIN_EMAIL=ceo@marioxsoftware.com
SUPER_ADMIN_PASSWORD=
# Founders HQ Founder seat (optional). Same email as SUPER_ADMIN_EMAIL = that Super Admin gets the seat;
# otherwise a new Super Admin with the seat is created (empty password = generated once).
# Mariox Partners has no separate admin account: Super Admins (and roles with the "pp" permission) run it.
HQ_FOUNDER_NAME=Founder
HQ_FOUNDER_EMAIL=
HQ_FOUNDER_PASSWORD=

# Email (SMTP). Invites / password resets are emailed when SMTP_USER + SMTP_PASS are set;
# otherwise the admin gets a one-time link to share. Google Workspace: smtp.gmail.com:587 with an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Mariox Software
# Frontend URL used in email links (production: your portal domain)
APP_URL=http://localhost:5180
# Emails to clients (needs SMTP above + the client's email on the project). true = when a PM clicks
# "Send to client" on a change request, or asks the client to approve a milestone, the client gets an email
# (replies go to the PM). false = nothing is emailed to clients; statuses still change as usual.
CLIENT_EMAILS=false

# Encrypts project third-party credentials (AES-256-GCM). Generate once:  openssl rand -base64 32
# Keep it backed up and never change it — saved credentials can't be read without the same key.
# Empty = saving credentials is turned off (third parties can still be listed).
CREDENTIALS_KEY=

# Founder summary for the cofounder portal (../../CofounderMariox): GET /api/v1/founder/summary with
# header x-founder-key: <this value>. Empty = the endpoint is off. Generate with: openssl rand -hex 24
FOUNDER_API_KEY=

# ---- Legacy data migration (one-off: `npm run migrate:legacy`, see docs/MIGRATION.md) ----
# Sources are only READ. Leave empty when not migrating. The target is MONGODB_URI above.
# Old internal portal (Postgres): postgres://user:password@host:5432/database (URL-encode special characters in the password)
LEGACY_PORTAL_PG_URL=""
# Old partner portal (mariox-saas, MongoDB) — must name the database, e.g. mongodb://user:password@host:27017/mariox
LEGACY_PARTNERS_MONGO_URI="";
# Old Founders HQ (CofounderMariox, MongoDB) — must name the database, e.g. mongodb://user:password@host:27017/founders_hq
LEGACY_HQ_MONGO_URI="";
# Optional. Best: set CREDENTIALS_KEY above to the old portal's CREDENTIALS_KEY and leave this empty (credentials are
# copied as stored). Only if Mariox One uses a NEW CREDENTIALS_KEY: put the old portal's key here and the migration
# re-encrypts project credentials from it to CREDENTIALS_KEY.
LEGACY_PORTAL_CREDENTIALS_KEY=

# Refresh cookie needs HTTPS in production. Only while testing on plain HTTP (http://<ip>) set this to false.
# COOKIE_SECURE=false
